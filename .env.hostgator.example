# Copy to .env.hostgator and use the existing trusted HostGator SSH connection.
# Never store passwords or private key contents here.
HOSTGATOR_HOST=hosting.example
HOSTGATOR_USER=owner
HOSTGATOR_PORT=2222
HOSTGATOR_REMOTE_DIR=public_html/tocatlian.com/apps/fx
HOSTGATOR_SSH_KEY=~/.ssh/your-existing-key
